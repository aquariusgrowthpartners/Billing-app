# dependencies / build output
node_modules/
.pnpm-store/
dist/
client/dist/

# ---------------------------------------------------------------
# Patient data. Never commit any of this.
# The whole data tree is ignored rather than individual patterns:
# backups/ holds VACUUM INTO copies of the live database, and the
# upload folders hold real RA PDFs and documents.
# ---------------------------------------------------------------
data/

# secrets / local config
.env
.env.*
!.env.example

# tooling
.cache/
.runtime/
.DS_Store
*.log
*.bak
*.bak-*

# Local PHI exports — never commit a database dump or import payload.
local-export.json
local-export.sql
