# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# SQLite file. On Railway mount a volume and point this at it, or the
# database is lost on every redeploy.
BILLING_DB=/data/billing.db

# Comma-separated extra origins allowed to call /api. Leave empty when the
# frontend and API share an origin (the Railway default).
ALLOWED_ORIGINS=

# Demo mode: seed a synthetic database and refuse to touch the real one.
DEMO_MODE=false
